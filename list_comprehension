#1. Squares of numbers
squares = [x**2 for x in range(1, 6)]
print("Squares:", squares)

# 2. Even numbers
even = [x for x in range(1, 11) if x % 2 == 0]
print("Even:", even)

# 3. Odd numbers
odd = [x for x in range(1, 11) if x % 2 != 0]
print("Odd:", odd)

# 4. Convert to uppercase
words = ["apple", "banana", "cherry"]
upper_words = [w.upper() for w in words]
print("Uppercase:", upper_words)

# 5. Filter strings (length > 4)
words2 = ["cat", "elephant", "dog", "tiger"]
long_words = [w for w in words2 if len(w) > 4]
print("Long words:", long_words)

# 6. Flatten nested list
matrix = [[1,2,3],[4,5,6],[7,8,9]]
flat = [num for row in matrix for num in row]
print("Flatten:", flat)

# 7. If-Else in list comprehension
result = ["Even" if x % 2 == 0 else "Odd" for x in range(1, 6)]
print("Even/Odd:", result)

# 8. Remove duplicates
nums = [1,2,2,3,4,4,5]
unique = list(set(nums))
print("Unique:", unique)

# 9. Squares of even numbers
sq_even = [x**2 for x in range(1, 11) if x % 2 == 0]
print("Square of Even:", sq_even)

# 10. Dictionary comprehension
nums2 = [1,2,3,4]
d = {x: x**2 for x in nums2}
print("Dictionary:", d)
